[user]
  name  = ooq-tiki
  email = ooq.tiki@gmail.com
[color "diff"]
  old = magenta
[color "status"]
  added     = cyan
  changed   = yellow
  untracked = yellow
  unmerged  = yellow
[core]
  pager = less -x2
  editor = vim
[pull]
  rebase = false
[init]
  defaultBranch = main
[merge]
  tool = vimdiff
[alias]
  l     = log
  ls    = ls-files
  s     = status
  d     = diff
  sl    = diff --staged --name-only
  wl    = diff          --name-only
  sd    = diff --staged
  wd    = diff
  a     = add
  # ao    = add .
  co    = commit
  pll   = pull
  p     = pull
  psh   = push
  mrg   = merge
  b     = branch
  ch    = checkout
  cnf   = config
[log]
  date = iso-local

