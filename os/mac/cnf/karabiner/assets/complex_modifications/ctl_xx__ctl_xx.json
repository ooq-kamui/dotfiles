{
  "title": "ctl key-bind [ @kamui ]",
  "rules": [
    {
      "description": "ctl key-bind",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "modifiers": {
              "mandatory": [ "control" ]
            },
            "key_code": "s"
          },
          "to": [
            {
              "modifiers": ["control"],
              "key_code": "b"
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$",
                "^com\\.apple\\.Safari$",
                "^com\\.apple\\.Notes$",
                "^com\\.apple\\.iCal$",
                "^com\\.apple\\.Music$",
                "^com\\.apple\\.MobileSMS$",
                "^com\\.google\\.Chrome$",
                "^com\\.pixelmatorteam\\.pixelmator\\.x$",
                "^org\\.godotengine\\.godot$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": {
              "mandatory": [ "control" ]
            },
            "key_code": "l"
          },
          "to": [
            {
              "modifiers": ["control"],
              "key_code": "f"
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.finder$",
                "^com\\.apple\\.Safari$",
                "^com\\.apple\\.Notes$",
                "^com\\.apple\\.iCal$",
                "^com\\.apple\\.Music$",
                "^com\\.apple\\.MobileSMS$",
                "^com\\.google\\.Chrome$",
                "^com\\.pixelmatorteam\\.pixelmator\\.x$",
                "^org\\.godotengine\\.godot$"
              ]
            }
          ]
        }
      ]
    }
  ]
}

